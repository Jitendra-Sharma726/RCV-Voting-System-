from rcv_core import calculate_rcv_winner

def main():
    ballots = [
            ["A", "B"],
            ["A", "B"],
            ["B", "A"],
            ["C", "A"],
            ["C", "B"]
        ]
    winner = calculate_rcv_winner(ballots)

    if winner is not None:
        print("\n🎉 The winner is:", winner)
    else:
        print("\nNo winner could be determined.")

if __name__ == "__main__":
    main()
